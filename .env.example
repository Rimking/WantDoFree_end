# 途记后端运行环境变量
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=tuji

# JWT
JWT_SECRET=change_me_to_a_strong_random_string
JWT_EXPIRES_IN=7d

# CORS：开发可留空（放行）；生产填逗号分隔白名单，禁止 *
CORS_ORIGIN=

# —— 存储驱动（Strategy）——
# local：落盘 + GET /dream/v1/files/... 回读（默认，本地真打通）
# cos：预签名直传腾讯云（前端契约不变）
STORAGE_DRIVER=local
UPLOAD_ROOT=./uploadImgFile
FILE_SERVE_PREFIX=/dream/v1/files

# 微信小程序（留空 = 开发模式：code 当作 openid；生产必须配置）
WX_APPID=
WX_SECRET=
# 开发登录 code=dev_openid_demo 时映射到的演示用户 openid（默认绑真机）
DEMO_USER_OPENID=oGSAD5cLUWt4wvvHh7G1gyQpyIFE

# 微信支付 v3（留空 = 仅 mock 下单；正式回调未接验签前会拒绝）
WX_MCH_ID=
# 本地模拟支付成功时使用：POST /dream/v1/pay/dev-complete + Header X-Dev-Pay-Secret
DEV_PAY_NOTIFY_SECRET=tuji_dev_pay

# 腾讯云 COS（STORAGE_DRIVER=cos 时使用；未接 SDK 前返回占位 URL）
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BASE_URL=

# 地图 POI / 逆地理；留空则 mock
# MAP_PROVIDER=tencent|amap
MAP_PROVIDER=
TENCENT_MAP_KEY=
AMAP_KEY=
