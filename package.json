{
  "name": "tuji-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migration:generate": "typeorm-ts-node-commonjs -d ./typeorm-cli.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d ./typeorm-cli.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d ./typeorm-cli.ts migration:revert",
    "seed:demo": "ts-node -r dotenv/config src/scripts/seed-demo.ts",
    "e2e:local": "ts-node --transpile-only src/scripts/e2e-local.ts",
    "cleanup:legacy-places": "ts-node -r dotenv/config src/scripts/cleanup-legacy-places.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/multer": "^2.2.0",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^2.2.0",
    "mysql2": "^3.11.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^16.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
