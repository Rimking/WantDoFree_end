# 途记后端运行环境变量
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=tuji

# JWT（必填：缺失时服务拒绝启动，不会回落默认值）
JWT_SECRET=change_me_to_a_strong_random_string
JWT_EXPIRES_IN=7d

# CORS：开发可留空（放行）；生产填逗号分隔白名单，禁止 *
CORS_ORIGIN=

# —— 存储驱动（Strategy）——
# local：落盘 + GET /dream/v1/files/... 回读（默认，本地真打通）
# cos：预签名直传腾讯云（前端契约不变）
STORAGE_DRIVER=local
UPLOAD_ROOT=./uploadImgFile
FILE_SERVE_PREFIX=/dream/v1/files

# 微信小程序（留空时仅可模拟登录，见 ENABLE_MOCK_LOGIN；生产必须配置）
WX_APPID=
WX_SECRET=
# 模拟登录 code=dev_openid_demo 映射到的演示用户 openid（本地自填，勿提交真实值）
DEMO_USER_OPENID=

# —— 开发调试开关（生产必须留空/关闭）——
# 调试支付通道（/pay/dev-complete、/membership/orders/:no/pay）：非生产 且 =true 才放行
ENABLE_DEV_PAY=
# 模拟登录（code 当 openid / 种子账号映射）：非生产 且 =true 才放行
ENABLE_MOCK_LOGIN=

# 微信支付 v3（留空 = 仅 mock 下单；正式回调未接验签前会拒绝）
WX_MCH_ID=
# 本地模拟支付密钥：自行生成随机值；未配置则 mock 支付一律拒绝（fail-closed）
# 用法：/pay/dev-complete 走 Header X-Dev-Pay-Secret；/membership/orders/:no/pay 走 body.secret
DEV_PAY_NOTIFY_SECRET=

# 腾讯云 COS（STORAGE_DRIVER=cos 时使用；未接 SDK 前返回占位 URL）
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BASE_URL=

# 地图 POI / 逆地理；留空则 mock
# MAP_PROVIDER=tencent|amap
MAP_PROVIDER=
TENCENT_MAP_KEY=
AMAP_KEY=
